# Copy to ignored .env locally or use your host's secret settings.
# Choose these bounds yourself before enabling execution.
TAVREN_EXECUTION_ENABLED=false
TAVREN_SERVICE_ENABLED=false
TAVREN_TRIGGER_BPS=
TAVREN_TARGET_BPS=
TAVREN_MAX_REPAY_USD=
TAVREN_DAILY_CAP_USD=
TAVREN_MAX_TX_FEE_BNB=
TAVREN_ALLOWED_MARKETS=
# Public HTTPS origin of the Node operator service, not the private UI.
TAVREN_PUBLIC_URL=
# Integer raw units of the Commerce deployment's payment token.
# Confirm its address and decimals on chain before choosing a price.
TAVREN_SERVICE_PRICE_RAW=
TAVREN_MAX_JOBS_PER_DAY=
# Existing encrypted BNB SDK keystore for the configured campaign wallet.
# Leave key material out of this file and out of chat.
TAVREN_WALLETS_DIR=
TAVREN_WALLET_PASSWORD=
AI_GATEWAY_API_KEY=
# Optional protected eve HTTP access; username is tavren. Store as a host Secret.
# Vercel OIDC access still works when this is unset. Never use the Gateway key here.
TAVREN_AGENT_PASSWORD=
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
TAVREN_STATE_DIR=.operator-state
TAVREN_BIND_HOST=127.0.0.1
PORT=3001
